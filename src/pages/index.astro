---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CategoryFilters from '../components/CategoryFilters.astro';
import GalleryMasonry from '../components/GalleryMasonry.astro';
import { categoriesOf } from '../utils/categories';

const collection = await getCollection('gallery');
const images = collection.map((a) => ({ ...a.data, id: a.id }));
const allCategories = [
  ...new Set(images.flatMap((img) => categoriesOf(img))),
].sort((a, b) => a.localeCompare(b));
---


<Layout title="Yun Portfolio">
  <div class="container mx-auto px-6 py-16">
    <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
      <h1 class="font-display text-4xl font-normal tracking-wide text-ink sm:text-5xl">
        Alvin Portfolio
      </h1>

      <nav class="flex items-center gap-4" aria-label="Social links">
        <a
          href="https://www.linkedin.com/in/yun-lai-43991043/"
          aria-label="LinkedIn"
          class="social-icon"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5.5 3A2.5 2.5 0 1 0 5.5 8 2.5 2.5 0 0 0 5.5 3ZM3.5 9H7v11H3.5V9ZM9 9h3.3v1.5h.05c.46-.87 1.58-1.8 3.25-1.8 3.48 0 4.12 2.29 4.12 5.27V20h-3.5v-5.35c0-1.28-.02-2.92-1.78-2.92-1.78 0-2.05 1.39-2.05 2.82V20H9V9Z" />
          </svg>
        </a>

        <a
          href="https://github.com/yun07"
          aria-label="GitHub"
          class="social-icon"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 .5A11.5 11.5 0 0 0 8.36 22.9c.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.53-1.35-1.3-1.71-1.3-1.71-1.07-.73.08-.72.08-.72 1.18.08 1.8 1.21 1.8 1.21 1.05 1.8 2.75 1.28 3.42.98.1-.76.41-1.28.75-1.57-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.2-3.1-.12-.3-.52-1.47.11-3.06 0 0 .98-.31 3.16 1.18A10.9 10.9 0 0 1 12 5.98c.99 0 1.99.13 2.92.39 2.18-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.06.75.81 1.2 1.84 1.2 3.1 0 4.42-2.69 5.4-5.25 5.68.42.36.8 1.07.8 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
          </svg>
        </a>

        <a
          href="https://www.artstation.com/alvinlain"
          aria-label="ArtStation"
          class="social-icon"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.8 3.5 21 17.7a1.6 1.6 0 0 1-1.38 2.4H9.9l-2-3.45h9.5L12.8 9.3 8.5 16.65H4.4L10.9 5.4a2.2 2.2 0 0 1 1.9-1.9Z" />
          </svg>
        </a>

        <a
          href="mailto:al-vfx@protonmail.com"
          aria-label="Email"
          class="social-icon"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 5.5A2.5 2.5 0 0 1 5.5 3h13A2.5 2.5 0 0 1 21 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 18.5v-13ZM5.5 6a.5.5 0 0 0-.31.89L12 12.25l6.81-5.36A.5.5 0 0 0 18.5 6h-13ZM19 8.16l-6.38 5.02a1 1 0 0 1-1.24 0L5 8.16v10.34c0 .28.22.5.5.5h13a.5.5 0 0 0 .5-.5V8.16Z" />
          </svg>
        </a>
      </nav>
    </header>

    <CategoryFilters categories={allCategories} active="all" />
    <GalleryMasonry images={images} />
  </div>
</Layout>

<style>
  .social-icon {
    display: inline-flex;
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    transition: color 200ms ease;
  }

  .social-icon:hover {
    color: var(--color-ink);
  }

  .social-icon svg {
    display: block;
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
</style>


