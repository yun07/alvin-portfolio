
---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import projects from '../../data/projects';
import { formatCategories } from '../../utils/categories';

export async function getStaticPaths() {
  const collection = await getCollection('gallery');

  return collection.map((entry) => {
    const image = { ...entry.data, id: entry.id };

    return {
      params: { title: image.id },
      props: { image },
    };
  });
}

const { image } = Astro.props;
const project = projects.find((item) => item.id === image.id);
const blocks = project?.blocks ?? [];
const { BASE_URL } = import.meta.env;
---

<Layout title={`${image.title} | Alvin Lai Portfolio`}>
  <main class="project-page mx-auto max-w-5xl px-6 py-12">
    <a
      href={BASE_URL}
      class="mb-10 inline-block text-sm text-muted hover:text-ink"
    >
      ← Back to Portfolio
    </a>

    <header class="mb-12">
      <p class="mb-3 text-sm tracking-wide text-muted">
        {formatCategories(image)}
      </p>

      <h1 class="mb-4 text-4xl font-normal tracking-wide text-ink">
        {image.title}
      </h1>

      {project?.subtitle && (
        <p class="text-lg text-muted">{project.subtitle}</p>
      )}

      <p class="mt-6 max-w-3xl leading-8 text-ink">
        {project?.intro ?? image.description}
      </p>
    </header>

    <section class="project-content">
      {blocks.map((block) => (
        <div class="project-block">
          {block.type === 'text' && (
            <div class="project-text">
              {block.heading && (
                <h2 class="mb-4 text-2xl text-ink">{block.heading}</h2>
              )}
              <div class="whitespace-pre-line leading-8 text-ink">
                {block.body}
              </div>
            </div>
          )}

          {(block.type === 'image' || block.type === 'gif') && (
            <figure>
              <img
                src={block.src}
                alt={block.alt}
                loading="lazy"
                class="project-image"
              />
              {'caption' in block && block.caption && (
                <figcaption>{block.caption}</figcaption>
              )}
            </figure>
          )}

          {block.type === 'video' && (
            <video
              controls
              playsinline
              preload="metadata"
              poster={block.poster}
              class="project-video"
            >
              <source src={block.src} type="video/mp4" />
              Your browser does not support video playback.
            </video>
          )}

          {block.type === 'embed' && (
            <div class="embed-wrapper">
              <iframe
                src={block.src}
                title={block.title}
                loading="lazy"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
              />
            </div>
          )}

          {block.type === 'gallery' && (
            <div class="project-gallery">
              {block.items.map((item) => (
                <figure>
                  <img
                    src={item.src}
                    alt={item.alt}
                    loading="lazy"
                    class="project-image"
                  />
                  {item.caption && <figcaption>{item.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )}
        </div>
      ))}
    </section>

    {blocks.length === 0 && (
      <p class="leading-8 text-muted">
        {image.description}
      </p>
    )}
  </main>
</Layout>

<style>
  .project-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .project-block,
  .project-block figure {
    min-width: 0;
    margin: 0;
  }

  .project-text {
    max-width: 48rem;
    margin-inline: auto;
    width: 100%;
  }

  .project-image,
  .project-video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.25rem;
  }

  .project-video {
    max-height: 85vh;
    background: #111;
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .project-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .embed-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .embed-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 640px) {
    .project-gallery {
      grid-template-columns: 1fr;
    }
  }
</style>

